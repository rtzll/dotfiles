# Executes commands at login, before .zshrc.
# Loaded once per login session — use for environment setup and slow-to-init tools.
# Scripts and SSH sessions load this but not .zshrc, so keep environment vars here.


# ── Environment ───────────────────────────────────────────────────────────────

# Default browser on macOS.
export BROWSER='open'

# Default editor — uses Helix when available, falls back to vim.
# GIT_EDITOR set separately as git doesn't always inherit $EDITOR.
if command -v hx >/dev/null 2>&1; then
  export EDITOR='hx'
  export VISUAL='hx'
  export GIT_EDITOR='hx'
else
  export EDITOR='vim'
  export VISUAL='vim'
fi

# Default pager and locale.
export PAGER='less'
export LESS='-F -g -i -M -R -S -w -X -z-4'
export LANG='en_US.UTF-8'


# ── PATH ──────────────────────────────────────────────────────────────────────

# Ensure PATH has no duplicates.
typeset -gU cdpath fpath mailpath path

# Bootstrap Homebrew — must run early so brew-installed tools are on PATH
# for everything that follows.
eval "$(/opt/homebrew/bin/brew shellenv)"

# pnpm stores its bin directory under ~/Library/pnpm.
export PNPM_HOME="$HOME/Library/pnpm"

# Tool installation directories; Homebrew provides deno.
export BUN_INSTALL="$HOME/.bun"
export PROTO_HOME="$HOME/.proto"

# Static PATH entries consolidated in one place.
path=(
  $HOME/.pi/agent/bin(N)
  $PROTO_HOME/shims(N)
  $PROTO_HOME/bin(N)
  $HOME/bin(N)
  $HOME/.local/bin(N)
  $HOME/.opencode/bin(N)
  $HOME/go/bin(N)
  $PNPM_HOME/bin(N)
  $PNPM_HOME(N)
  $BUN_INSTALL/bin(N)
  "/Users/christianrotzoll/Library/Application Support/Coursier/bin"(N)
  /opt/homebrew/opt/sqlite/bin(N)
  $HOME/sbin(N)
  /opt/{homebrew,local}/{,s}bin(N)
  /usr/local/{,s}bin(N)
  $path
)


# ── Haskell ───────────────────────────────────────────────────────────────────
#
# ghcup manages the Haskell toolchain: GHC compiler, cabal, stack, HLS.
[ -f "$HOME/.ghcup/env" ] && source "$HOME/.ghcup/env"


# ── OCaml ─────────────────────────────────────────────────────────────────────
#
# opam is the OCaml package manager. Its init script sets PATH and environment
# variables for the active switch (compiler version + installed packages).
[[ ! -r "$HOME/.opam/opam-init/init.zsh" ]] || source "$HOME/.opam/opam-init/init.zsh" > /dev/null 2> /dev/null


# ── Tools ─────────────────────────────────────────────────────────────────────

# OrbStack — command-line tools and shell integration.
source ~/.orbstack/shell/init.zsh 2>/dev/null || :


# ── Java / JVM ────────────────────────────────────────────────────────────────
#
# SDKMAN manages JVM tooling: Java, Kotlin, Gradle, Maven, Scala, etc.
# Binaries live in ~/.sdkman/candidates/ and only land on PATH when loaded —
# removing this would break java, gradle, etc.
#
# NOTE: Must remain at the end of the file — SDKMAN requires this.
export SDKMAN_DIR="$HOME/.sdkman"
[[ -s "$HOME/.sdkman/bin/sdkman-init.sh" ]] && source "$HOME/.sdkman/bin/sdkman-init.sh"
