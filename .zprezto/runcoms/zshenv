# Defines environment variables for all shells.
# Loaded for every shell invocation: interactive, non-interactive, scripts, cron.
# Keep extremely minimal — this runs on every shell including scripts.

# Prezto: ensure non-login, non-interactive shells (e.g. scripts) still get
# the login environment by sourcing .zprofile when needed.
if [[ ( "$SHLVL" -eq 1 && ! -o LOGIN ) && -s "${ZDOTDIR:-$HOME}/.zprofile" ]]; then
  source "${ZDOTDIR:-$HOME}/.zprofile"
fi

# Rust toolchain — needed in scripts and non-interactive shells.
. "$HOME/.cargo/env"
