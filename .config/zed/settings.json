{
  "agent": { "enabled": false },
  "cli_default_open_behavior": "new_window",
  "outline_panel": {
    "dock": "right"
  },
  "collaboration_panel": {
    "dock": "right"
  },
  "git_panel": {
    "dock": "right"
  },
  "project_panel": { "dock": "right" },
  "features": { "edit_prediction_provider": "none" },
  "cursor_blink": false,
  "theme": "Andromeda",
  "buffer_font_size": 15,
  "buffer_font_features": { "calt": false },
  "telemetry": {
    "diagnostics": false,
    "metrics": false
  },
  "vim_mode": true,
  "languages": {
    "HTML": {
      "format_on_save": "off"
    }
  }
}
