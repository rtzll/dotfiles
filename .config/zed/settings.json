{
  "agent": { "enabled": false },
  "project_panel": { "dock": "right" },
  "features": { "edit_prediction_provider": "none" },
  "cursor_blink": false,
  "theme": "Andromeda",
  "buffer_font_size": 15,
  "buffer_font_features": { "calt": false },
  "telemetry": {
    "diagnostics": false,
    "metrics": false
  },
  "vim_mode": true,
  "lsp": {
    "texlab": {
      "settings": {
        "texlab": {
          "build": {
            "onSave": false
          }
        }
      }
    }
  },
  "languages": {
    "HTML": {
      "format_on_save": "off"
    }
  }
}
