# Login-session setup, loaded before .zshrc.
# Essential paths for scripts and non-login shells live in .zshenv.


# ── Environment ───────────────────────────────────────────────────────────────

# Default browser on macOS.
export BROWSER='open'

# Default editor — uses Helix when available, falls back to vim.
# GIT_EDITOR set separately as git doesn't always inherit $EDITOR.
if command -v hx >/dev/null 2>&1; then
  export EDITOR='hx'
  export VISUAL='hx'
  export GIT_EDITOR='hx'
else
  export EDITOR='vim'
  export VISUAL='vim'
fi

# Default pager; locale is configured in .zshenv.
export PAGER='less'
export LESS='-F -g -i -M -R -S -w -X -z-4'


# ── PATH ──────────────────────────────────────────────────────────────────────

# Ensure PATH has no duplicates.
typeset -gU cdpath fpath mailpath path

# Bootstrap Homebrew — must run early so brew-installed tools are on PATH
# for everything that follows.
if (( $+commands[brew] )); then
  eval "$(brew shellenv)"
fi

# ── Haskell ───────────────────────────────────────────────────────────────────
#
# ghcup manages the Haskell toolchain: GHC compiler, cabal, stack, HLS.
[[ -r "$HOME/.ghcup/env" ]] && source "$HOME/.ghcup/env"


# ── OCaml ─────────────────────────────────────────────────────────────────────
#
# opam is the OCaml package manager. Its init script sets PATH and environment
# variables for the active switch (compiler version + installed packages).
if [[ -r "$HOME/.opam/opam-init/init.zsh" ]]; then
  source "$HOME/.opam/opam-init/init.zsh" > /dev/null 2>&1
fi


# ── Tools ─────────────────────────────────────────────────────────────────────

# OrbStack — command-line tools and shell integration.
[[ -r "$HOME/.orbstack/shell/init.zsh" ]] && source "$HOME/.orbstack/shell/init.zsh"


# ── Java / JVM ────────────────────────────────────────────────────────────────
#
# SDKMAN manages JVM tooling: Java, Kotlin, Gradle, Maven, Scala, etc.
# Binaries live in ~/.sdkman/candidates/ and only land on PATH when loaded —
# removing this would break java, gradle, etc.
#
# NOTE: Must remain at the end of the file — SDKMAN requires this.
export SDKMAN_DIR="$HOME/.sdkman"
[[ -r "$HOME/.sdkman/bin/sdkman-init.sh" ]] && source "$HOME/.sdkman/bin/sdkman-init.sh"
